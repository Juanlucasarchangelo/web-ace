# Preferir INICIAR-ACE.bat (gera .env com secrets). NAO use este arquivo diretamente para inicializar o banco.
APP_NAME=ACE
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8088
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ace_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=ace_docker_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=127.0.0.1,127.0.0.1:8088,localhost,localhost:8088
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=ACE

# ACE IA Premium: nunca inclua a GEMINI_API_KEY no código ou no navegador.
ACE_AI_PROVIDER=local
# Modelo Gemini opcional, dependente de disponibilidade e limites da sua conta Google.
# O modo padrao local nao exige chave externa.
ACE_AI_MODEL=gemini-3.8-flash
ACE_AI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_API_KEY=

# ACE: checkout Mercado Pago. INATIVO até configurar conta, HTTPS e dados legais.
# Checkout Pro: Pix, cartão e boleto conforme meios habilitados na conta do vendedor.
# Ciclos são pré-pagos (sem renovação automática). Nunca coloque tokens no frontend.
ACE_PAYMENTS_ENABLED=false
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SELLER_ID=
ACE_BILLING_PUBLIC_URL=
ACE_LEGAL_NAME=
ACE_LEGAL_CNPJ=
ACE_LEGAL_ADDRESS=
ACE_PRIVACY_CONTACT=
ACE_SUPPORT_CONTACT=

# Porta LOCAL do ingresso opcional exclusivo para Webhooks Mercado Pago (Cloudflare)
ACE_WEBHOOK_PORT=8099
